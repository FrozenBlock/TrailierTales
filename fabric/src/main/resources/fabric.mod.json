{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Overhauls the Trails & Tales update, adding features and improving existing ones.",
  "authors": [
    "Luna",
    "wigglewoggle"
  ],
  "contributors": [
    "zhen",
    "voxelotl",
    "Soro335",
    "Stella/Osmiooo",
    "Eggmanplant"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${source_url}",
    "issues": "${issues_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/trailiertales/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.frozenblock.trailiertales.TrailierTalesFabric"
    ],
    "client": [
      "net.frozenblock.trailiertales.TrailierTalesClientFabric"
    ],
    "modmenu": [
      "net.frozenblock.trailiertales.config.modmenu.ModMenuIntegration"
    ],
    "fabric-datagen": [
      "net.frozenblock.trailiertales.data.TTDataGenerator"
    ]
  },
  "mixins": [
    "trailiertales.mixins.json",
    "trailiertales.mixins.fabric.json"
  ],
  "accessWidener": "trailiertales.classtweaker",
  "depends": {
    "frozenlib": "${frozenlib_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "X": "https://x.com/FB_Oasis",
        "Bluesky": "https://bsky.app/profile/frozenblock.bsky.social",
        "modmenu.discord": "https://discord.gg/frozenblock",
        "modmenu.modrinth": "https://modrinth.com/organization/frozenblock",
        "modmenu.youtube": "https://www.youtube.com/@frozenblockmoddingoasismod",
        "modmenu.kofi": "https://ko-fi.com/frozenblock"
      },
      "badges": [
        "frozenblock"
      ]
    },
    "frozenlib_registry": {
      "mod_protocol": $protocol_version
    },
    "lithium:options": {
      "mixin.world.raycast": false
    }
  }
}
